{
	"name": "obsidian-story-time",
	"version": "1.0.0",
	"description": "Create narrative journeys by tracking concepts across your vault",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"story",
		"narrative",
		"concept-tracking"
	],
	"license": "MIT",
	"dependencies": {
		"jszip": "^3.10.1"
	},
	"devDependencies": {
		"@types/jszip": "^3.4.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^5.29.0",
		"@typescript-eslint/parser": "^5.29.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
